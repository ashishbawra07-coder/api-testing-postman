{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "BookStore API",
    "description": "Complete API test suite for the BookStore API (demoqa.com). Covers authentication, book listing, add/update/delete operations with automated assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Generate Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has token field', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "    // Save token if credentials are valid",
                  "    if (jsonData.token) {",
                  "        pm.collectionVariables.set('token', jsonData.token);",
                  "    }",
                  "});",
                  "",
                  "pm.test('Response has status field', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.be.oneOf(['Authorization Successful', 'Failed']);",
                  "});",
                  "",
                  "pm.test('Response time is less than 5000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Account/v1/GenerateToken",
              "host": ["{{baseUrl}}"],
              "path": ["Account", "v1", "GenerateToken"]
            }
          }
        }
      ]
    },

    {
      "name": "📚 Books",
      "item": [
        {
          "name": "Get All Books",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has books array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('books');",
                  "    pm.expect(jsonData.books).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Books array is not empty', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.books.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test('Each book has required fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.books.forEach(function(book) {",
                  "        pm.expect(book).to.have.property('isbn');",
                  "        pm.expect(book).to.have.property('title');",
                  "        pm.expect(book).to.have.property('author');",
                  "    });",
                  "    // Save first ISBN for later tests",
                  "    pm.collectionVariables.set('isbn', jsonData.books[0].isbn);",
                  "});",
                  "",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Response time is less than 5000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/BookStore/v1/Books",
              "host": ["{{baseUrl}}"],
              "path": ["BookStore", "v1", "Books"]
            }
          }
        },
        {
          "name": "Get Single Book by ISBN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Book has correct structure', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('isbn');",
                  "    pm.expect(jsonData).to.have.property('title');",
                  "    pm.expect(jsonData).to.have.property('subTitle');",
                  "    pm.expect(jsonData).to.have.property('author');",
                  "    pm.expect(jsonData).to.have.property('publish_date');",
                  "    pm.expect(jsonData).to.have.property('publisher');",
                  "    pm.expect(jsonData).to.have.property('pages');",
                  "    pm.expect(jsonData).to.have.property('description');",
                  "    pm.expect(jsonData).to.have.property('website');",
                  "});",
                  "",
                  "pm.test('ISBN matches request', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.isbn).to.eql(pm.collectionVariables.get('isbn'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/BookStore/v1/Book?ISBN={{isbn}}",
              "host": ["{{baseUrl}}"],
              "path": ["BookStore", "v1", "Book"],
              "query": [
                {
                  "key": "ISBN",
                  "value": "{{isbn}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Book - Invalid ISBN (Negative Test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 for invalid ISBN', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error message is returned', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/BookStore/v1/Book?ISBN=INVALID-ISBN-123",
              "host": ["{{baseUrl}}"],
              "path": ["BookStore", "v1", "Book"],
              "query": [
                {
                  "key": "ISBN",
                  "value": "INVALID-ISBN-123"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "👤 User Account",
      "item": [
        {
          "name": "Get User Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 401', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test('User has correct structure', function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData).to.have.property('userId');",
                  "        pm.expect(jsonData).to.have.property('username');",
                  "        pm.expect(jsonData).to.have.property('books');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/Account/v1/User/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["Account", "v1", "User", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "🏥 Health & Smoke",
      "item": [
        {
          "name": "BookStore API - Smoke Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API is reachable - status not 5xx', function () {",
                  "    pm.expect(pm.response.code).to.not.be.oneOf([500, 502, 503, 504]);",
                  "});",
                  "",
                  "pm.test('Response time under 10 seconds', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(10000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/BookStore/v1/Books",
              "host": ["{{baseUrl}}"],
              "path": ["BookStore", "v1", "Books"]
            }
          }
        }
      ]
    }
  ]
}
